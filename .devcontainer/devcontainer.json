{
  "name": "AEGIS GitHub-only workspace",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [
    3000,
    8000
  ],
  "portsAttributes": {
    "3000": {
      "label": "AEGIS dashboard preview",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    },
    "8000": {
      "label": "AEGIS API (private)",
      "visibility": "private"
    }
  },
  "postCreateCommand": "npm install",
  "postStartCommand": "bash .devcontainer/start-services.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "tamasfe.even-better-toml"
      ]
    }
  },
  "postAttachCommand": "bash .devcontainer/start-dashboard.sh"
}
